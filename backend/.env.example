# Copy this file to .env and fill in real values. Never commit .env.

PORT=8080

# Auth0 -> Applications -> APIs -> your API
# Domain looks like: your-tenant.us.auth0.com (no https://)
AUTH0_DOMAIN=your-tenant.us.auth0.com
# The API "Identifier" you chose, e.g. https://starter-api
AUTH0_AUDIENCE=https://starter-api

# Where the Flutter web app runs (comma-separated if more than one)
CORS_ORIGINS=http://localhost:3000

# --- Added later, backend only (never put these in the Flutter app) ---
# GEMINI_API_KEY=
# DATABASE_URL=   (Tiger Data connection string)
